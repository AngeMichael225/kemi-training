# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only seed/import helpers. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required by scripts/seed-supabase.ts so seeded private rows belong to the Auth user.
KEMI_USER_ID=

# Optional application URL used by auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
