# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Preferred server-only seed key (sb_secret_...). Never expose this to the browser, Vercel, or git.
SUPABASE_SECRET_KEY=

# Temporary fallback used when SUPABASE_SECRET_KEY is unset. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required by scripts/seed-supabase.ts so seeded private rows belong to the Auth user.
KEMI_USER_ID=

# Optional application URL used by auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
