{
  "name": "kemi-training",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "24.x",
    "pnpm": "10.17.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "playwright test --project=webkit-compact-iphone",
    "import:training": "python scripts/import_training_xlsx.py \"data/source/Training Routine - KEMI S.xlsx\" seed/kemi-training-program.json --report seed/import-report.json",
    "seed": "tsx scripts/seed-supabase.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset --local --no-seed",
    "supabase:types": "tsx scripts/generate-db-types.ts",
    "supabase:test": "supabase test db --local",
    "supabase:lint": "supabase db lint --local --fail-on error",
    "supabase:bootstrap": "tsx scripts/bootstrap-local-supabase.ts",
    "test:supabase": "playwright test -c playwright.supabase.config.ts",
    "import-training-xlsx": "./scripts/import-training-xlsx"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.0.0",
    "idb": "^8.0.0",
    "lottie-react": "^3.1.2",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^26.0.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
